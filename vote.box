.box {
    position: relative;
    width: 350px;
    margin: auto;
    padding: 30px;
    border-radius: 15px;
    overflow: hidden;
}

.box::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("voting.jpg") center/cover no-repeat;
    opacity: 0.25;
    z-index: 0;
}

.box > * {
    position: relative;
    z-index: 1;
}